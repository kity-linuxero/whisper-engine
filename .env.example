# ---- Obligatorio -------------------------------------------------------------
# Token que los clientes mandan como "Authorization: Bearer <token>".
# Generar con: openssl rand -hex 32
ENGINE_TOKEN=

# ---- Modelos e idioma --------------------------------------------------------
# Docker: modelos a bajar al arrancar (el primero es el default).
WHISPER_MODELS=small
# Idioma por defecto (código ISO-639-1) o "auto" para autodetectar.
WHISPER_LANGUAGE=es
# auto = usa la iGPU si hay IR de OpenVINO y /dev/dri disponible; cpu | gpu fuerzan.
#WHISPER_DEVICE=auto
# Parámetros extra para whisper-cli. Los defaults evitan loops de alucinación
# en audios largos (cortar tramos de voz a 20 s, sin contexto entre ventanas).
WHISPER_EXTRA_ARGS=-vmsd 20 -mc 0
#WHISPER_THREADS=0

# ---- Límites -----------------------------------------------------------------
MAX_UPLOAD_MB=2048
MAX_JOB_MINUTES=90
# Los trabajos terminados que nadie borró se eliminan pasado este tiempo.
JOB_TTL_HOURS=24

# ---- Docker compose ----------------------------------------------------------
# IP del host donde publicar los puertos (0.0.0.0 = todas).
#BIND_HOST=0.0.0.0
#ENGINE_PORT=8080
#APP_PORT=3000
# Solo con docker-compose.intel.yml: GID de /dev/dri/renderD128 en el host
# (stat -c %g /dev/dri/renderD128) y rama del runtime Intel.
#RENDER_GID=993
#INTEL_RUNTIME=current          # legacy para Gen9-Gen11 (ej. HD 630)
#INTEL_RUNTIME_SUFFIX=          # "-legacy" para usar la imagen publicada legacy
